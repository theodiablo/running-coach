<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Supabase OAuth / magic-link redirect deep link. Must match
                 AUTH_DEEP_LINK in src/supabase.js and the Supabase Auth redirect
                 allow-list. App.jsx completes the PKCE exchange on receipt. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="solutions.camboulive.run" android:host="auth-callback" />
            </intent-filter>

            <!-- Cloud-provider OAuth return deep links (one host per provider —
                 see CLOUD_OAUTH in src/cloudOauthPreinit.ts). The provider
                 redirects to the registered https web origin; the web app's
                 cloudOauthPreinit bounces the code here (state marker
                 "<provider>_import:native:…"). App.tsx stashes it and the
                 provider's completeAuth exchanges it server-side. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="solutions.camboulive.run" android:host="polar-callback" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="solutions.camboulive.run" android:host="suunto-callback" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="solutions.camboulive.run" android:host="coros-callback" />
            </intent-filter>

            <!-- Health Connect client declaration (Android 14+, where Health Connect is
                 in the platform). Without this, Health Connect doesn't recognise the app
                 and permission requests return ungranted with no dialog. The target
                 (MainActivity) shows the app, from which the privacy policy is reachable. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>

        </activity>

        <!-- Same Health Connect client declaration for Android 13 and lower, where
             Health Connect is a separate app and expects an exported activity-alias. -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".MainActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <!-- Holds the app process while an INDOOR session records
             (docs/indoor-sessions.md). Typed connectedDevice because what must
             survive backgrounding is the BLE heart-rate link; JS only starts it
             while a live strap is streaming. A GPS run is held by the
             background-geolocation plugin's own location service instead. -->
        <service
            android:name=".IndoorSessionService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Live GPS run tracking (Phase 2). Foreground fine/coarse location plus
         ACCESS_BACKGROUND_LOCATION so recording keeps receiving fixes with the
         screen off — the foreground-service-only model left minutes-long GPS holes
         on some devices once the WebView froze. Background is requested in-context
         (only after the prominent BgLocationDisclosure + a foreground grant, when
         the user starts a run) and the watcher is active only during a run (never
         24/7). Shipping this permission requires the Google Play background-location
         declaration + Data Safety entry — see docs/background-location.md. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- Foreground service that holds the location while recording. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- Indoor sessions run no location watch, so the service that holds them is
         typed connectedDevice — the BLE strap. Its prerequisite permissions
         (BLUETOOTH_CONNECT/BLUETOOTH_SCAN) are already declared below. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />

    <!-- Persistent "recording run" notification (runtime-requested on Android 13+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Screen-off live-share uploads (LivePublishPlugin): GNSS only wakes the
         AP to deliver the fix, so a timed partial wake lock keeps the device up
         long enough for the 30s-cadence upload to complete. Normal-level, no
         runtime prompt. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Guided-workout step cues (WorkoutGuidePlugin): a short buzz alongside
         the tone/voice on each step boundary. Normal-level, no runtime prompt. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Live heart-rate sensor over Bluetooth LE (chest strap / armband / watch
         broadcasting HR). Scanning is flagged neverForLocation so it never implies
         location access; connect is needed to read the sensor. Also the
         prerequisite for the connectedDevice service above, which holds an indoor
         session's BLE link while the app is backgrounded (a GPS run is held by
         the location service instead). -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Legacy Bluetooth for API 26-30 (before BLUETOOTH_SCAN/CONNECT); on those
         versions scanning also uses the fine-location permission already declared
         above for GPS. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />

    <!-- Health Connect: read continuous heart rate from the user's watch post-run
         (HeartRateSeries), so no on-watch workout is required. Requires a Google Play
         health-data declaration + privacy policy before release. The read scope below,
         the <queries> block, and the VIEW_PERMISSION_USAGE activity declarations above
         (the plugin ships an empty manifest, so the app must declare them) together let
         Health Connect recognise the app and grant permission. -->
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />

    <!-- Post-run watch import (WatchImportPlugin): read finished exercise sessions
         and their distance / elevation gain that a watch (e.g. Garmin Connect on
         Android 14+) has written to Health Connect, so a phone-free run still lands
         in the log. Each of these read scopes must also be declared in the Google
         Play health-data declaration before release. -->
    <uses-permission android:name="android.permission.health.READ_EXERCISE" />
    <uses-permission android:name="android.permission.health.READ_DISTANCE" />
    <uses-permission android:name="android.permission.health.READ_ELEVATION_GAINED" />

    <!-- GPS route of an imported exercise session, so a phone-free run can land
         with a map instead of distance-only. Unlike every scope above, Health
         Connect will NOT grant this from our permission sheet: requests for it
         are ignored, and the user turns it on themselves (Health Connect →
         app permissions → "Exercise routes", or the per-session route consent
         dialog). Declaring it is what makes that toggle exist at all.
         The import treats it as strictly optional — a session whose route is
         absent or unconsented imports exactly as before, with no map — so this
         permission never gates the Health Connect connection. It is a new
         health scope and so needs a Google Play health-data declaration update
         before release (docs/health-integrations.md). -->
    <uses-permission android:name="android.permission.health.READ_EXERCISE_ROUTES" />

    <queries>
        <package android:name="com.google.android.apps.healthdata" />
        <intent>
            <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
        </intent>
    </queries>
</manifest>
