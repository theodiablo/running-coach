+    // against it. `healthConnectClient` above throws exactly that way (lazy
+    // HealthConnectClient.getOrCreate) whenever Health Connect is absent, which
+    // is the normal state on Android 13 and below: opening Settings →
+    // Integrations, which checks the permission, closed the app outright.
+    // Route failures back to the caller as a rejected promise instead.
+    private fun launchForCall(call: PluginCall, block: suspend () -> Unit) {
+        this.activity.lifecycleScope.launch {
+            try {
+                block()
+            } catch (e: Exception) {
+                call.reject(e.message ?: "Health Connect is unavailable", e)
+            }
+        }
+    }
