+    // Current pace over the accepted fixes of the last LIVE_CUR_PACE_WINDOW_MS,
+    // matching the tracker's curPace; 0 when the window can't support a figure.
+    private double windowPaceSecPerKm(LiveStats live) {
+        if (live.paceWindow.size() < 2) {
+            return 0;
+        }
+        double[] first = live.paceWindow.peekFirst();
+        double[] last = live.paceWindow.peekLast();
+        double km = (last[1] - first[1]) / 1000, seconds = (last[0] - first[0]) / 1000;
+        return (km > 0 && seconds > 0) ? seconds / km : 0;
+    }
+
+    // fmt.pace (src/utils/format.ts), rounding included, so the strings match.
+    private static String formatPace(double secPerKm) {
+        if (secPerKm <= 0) {
+            return "--:--";
+        }
+        long minutes = (long) Math.floor(secPerKm / 60);
+        long seconds = Math.round(secPerKm % 60);
+        return minutes + ":" + (seconds < 10 ? "0" : "") + seconds;
+    }
+
+    // haversineM (src/utils/geo.ts) — same formula and radius as the tracker's.
+    private static double haversineM(double lat1, double lng1, double lat2, double lng2) {
+        double dLat = Math.toRadians(lat2 - lat1), dLng = Math.toRadians(lng2 - lng1);
+        double s = Math.pow(Math.sin(dLat / 2), 2)
+                + Math.cos(Math.toRadians(lat1)) * Math.cos(Math.toRadians(lat2))
+                * Math.pow(Math.sin(dLng / 2), 2);
+        return 2 * EARTH_RADIUS_M * Math.asin(Math.min(1, Math.sqrt(s)));
