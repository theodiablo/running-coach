+    private String liveMessage(LiveStats live) {
+        double pace = windowPaceSecPerKm(live);
+        if (pace <= 0) {
+            pace = live.fallbackPaceSecPerKm;
+        }
+        StringBuilder message = new StringBuilder(
+                String.format(Locale.US, "%.2f km", live.baseKm + live.addedM / 1000)
