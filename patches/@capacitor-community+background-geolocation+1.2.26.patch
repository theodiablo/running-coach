+        boolean updateNotification(Notification notification) {
+            boolean hasForegroundNotification = false;
+            for (Watcher watcher : watchers) {
+                if (watcher.backgroundNotification != null) {
+                    // Keep getNotification() consistent with what is displayed.
+                    watcher.backgroundNotification = notification;
+                    hasForegroundNotification = true;
+                }
