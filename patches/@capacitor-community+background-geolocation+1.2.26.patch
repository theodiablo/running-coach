+    private void foldLiveLocation(LiveStats live, Location location) {
+        double accuracy = location.hasAccuracy() ? location.getAccuracy() : 0;
+        if (location.hasAccuracy() && accuracy > LIVE_ACC_MAX_M) {
+            return;
+        }
+        long t = location.getTime() > 0 ? location.getTime() : System.currentTimeMillis();
+        double lat = location.getLatitude(), lng = location.getLongitude();
+        if (live.lastFixMs == 0) {
+            // Warm-up: don't anchor on a coarse (or unknown-accuracy) pre-lock fix.
+            if (!location.hasAccuracy() || accuracy > LIVE_ACC_WARMUP_M) {
+                return;
+            }
+            live.lastLat = lat;
+            live.lastLng = lng;
+            live.lastFixMs = t;
+            live.paceWindow.clear();
+            live.paceWindow.addLast(new double[] { t, live.cumM });
+            journalFix(lat, lng, t, location);
+            relayLiveFix(live, lat, lng, t, location, false);
+            return; // an anchor only — no leg to measure yet
+        }
+        if (t - live.lastFixMs < LIVE_MIN_INTERVAL_MS) {
+            return;
+        }
+        double moved = haversineM(live.lastLat, live.lastLng, lat, lng);
+        if (moved < Math.max(LIVE_MIN_MOVE_M, accuracy * 0.5)) {
+            return; // jitter, not movement
+        }
+        boolean gapBefore = t - live.lastFixMs > LIVE_GAP_MS;
+        live.lastLat = lat;
+        live.lastLng = lng;
+        live.lastFixMs = t;
+        live.addedM += moved;
+        live.cumM += moved;
+        live.paceWindow.addLast(new double[] { t, live.cumM });
+        while (live.paceWindow.size() > 1
+                && t - live.paceWindow.peekFirst()[0] > LIVE_CUR_PACE_WINDOW_MS) {
+            live.paceWindow.removeFirst();
+        }
+        journalFix(lat, lng, t, location);
+        relayLiveFix(live, lat, lng, t, location, gapBefore);
+        renderLiveStats(live);
+    }
