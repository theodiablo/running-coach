+    // ── HR journal ───────────────────────────────────────────────────────────
+
+    private fun hrJournalFile(): File {
+        return File(context.filesDir, HR_JOURNAL_FILE)
+    }
+
+    // One "<epochMs> <hex>" line per measurement. Line-oriented on purpose: a
+    // torn last line (process killed mid-write) costs one beat, not the journal.
+    private fun journalHrMeasurement(characteristic: UUID, value: String) {
+        if (!hrJournalArmed) return
+        if (characteristic != HR_MEASUREMENT_UUID) return
+        synchronized(hrJournalLock) {
+            try {
+                val file = hrJournalFile()
+                if (file.length() > HR_JOURNAL_MAX_BYTES) return
+                FileWriter(file, true).use { writer ->
+                    writer.write("${System.currentTimeMillis()} $value\n")
+                }
+            } catch (exception: Exception) {
+                // Best-effort: a journalling failure must never affect the stream.
+            }
+        }
+    }
+
+    @PluginMethod
+    fun setHrJournal(call: PluginCall) {
+        hrJournalArmed = call.getBoolean("enabled", false) == true
+        call.resolve()
+    }
+
+    // Resolves { entries: [{ t, v }, ...] }; the caller parses `v` with the same
+    // measurement parser the live stream uses.
+    @PluginMethod
+    fun getHrJournal(call: PluginCall) {
+        val entries = JSArray()
+        synchronized(hrJournalLock) {
+            try {
+                val file = hrJournalFile()
+                if (file.exists()) {
+                    file.forEachLine { line ->
+                        val sep = line.indexOf(' ')
+                        if (sep > 0) {
+                            val t = line.substring(0, sep).toLongOrNull()
+                            val v = line.substring(sep + 1).trim()
+                            if (t != null && v.isNotEmpty()) {
+                                val entry = JSObject()
+                                entry.put("t", t)
+                                entry.put("v", v)
+                                entries.put(entry)
+                            }
+                        }
+                    }
+                }
+            } catch (exception: Exception) {
+                Logger.error(TAG, "Failed to read HR journal", exception)
+            }
+        }
+        val ret = JSObject()
+        ret.put("entries", entries)
+        call.resolve(ret)
+    }
+
+    @PluginMethod
+    fun clearHrJournal(call: PluginCall) {
+        synchronized(hrJournalLock) {
+            try {
+                hrJournalFile().delete()
+            } catch (exception: Exception) {
+                // Best-effort.
+            }
+        }
+        call.resolve()
+    }
